{
  "manifest_version": 3,
  "name": "Zero-Trust Focus",
  "version": "1.0",
  "description": "Monitors active tabs and communicates with Zero-Trust Focus Platform.",
  "permissions": [
    "tabs",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://zero-trust-focus-platform-1.onrender.com/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
